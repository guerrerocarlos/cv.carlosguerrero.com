{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carlosguerrero-cv-gateway",
  "main": "worker/cv-gateway.js",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "carlosguerrero.com/cv*",
      "zone_name": "carlosguerrero.com"
    },
    {
      "pattern": "www.carlosguerrero.com/cv*",
      "zone_name": "carlosguerrero.com"
    },
    {
      "pattern": "cv.carlosguerrero.com/*",
      "zone_name": "carlosguerrero.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
